---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" noindex>
  <section class="wrap texto" style="text-align:center;justify-items:center;display:grid;gap:12px">
    <h1>Página não encontrada</h1>
    <p>O endereço pode ter mudado ou o produto saiu da loja.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:12px">
      <a class="btn btn-gold" href="/produtos/">Ver produtos</a>
      <a class="btn btn-line" href="/">Página inicial</a>
    </div>
  </section>
</Base>
